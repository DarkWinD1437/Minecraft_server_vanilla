/* ═══════════════════════════════════════════
   COMMON COMPONENTS
   ═══════════════════════════════════════════ */

/* ─── Section headers ─── */
.section-header {
    text-style: bold underline;
    color: $accent;
    margin: 1 0;
}

/* ─── Form fields ─── */
.field-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
    align: left middle;
}

.field-label {
    width: 20;
    color: $text-muted;
}

.field-input {
    width: 1fr;
}

/* ─── Info labels ─── */
.info-label {
    color: $text-muted;
    text-style: italic;
}

/* ─── Warning/error banners ─── */
.banner-warning {
    background: $warning-darken-2;
    color: $text;
    padding: 0 1;
    margin-bottom: 1;
}

.banner-error {
    background: $error-darken-2;
    color: $text;
    padding: 0 1;
    margin-bottom: 1;
}

.banner-success {
    background: $success-darken-2;
    color: $text;
    padding: 0 1;
    margin-bottom: 1;
}

/* ─── Toolbar ─── */
.toolbar {
    layout: horizontal;
    height: 3;
    background: $panel-darken-1;
    padding: 0 1;
    align: left middle;
}

.toolbar Input {
    width: 20;
    margin-right: 1;
}

.toolbar Button {
    margin-right: 1;
    height: 3;
}

.toolbar Select {
    width: 15;
    margin-right: 1;
}

/* ─── Collapsible sections ─── */
Collapsible {
    margin-bottom: 1;
    border: solid $primary-darken-2;
}

/* ─── Progress bars ─── */
ProgressBar {
    height: 1;
}

/* ─── Tabs ─── */
TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 1;
}

/* ─── RichLog / console ─── */
RichLog {
    background: $surface-darken-1;
    border: solid $primary-darken-3;
}

/* ─── Switch row ─── */
.switch-row {
    layout: horizontal;
    height: 3;
    align: left middle;
    margin-bottom: 1;
}

.switch-label {
    width: 1fr;
}
